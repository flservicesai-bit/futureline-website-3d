generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id @default(cuid())
  firstName        String              @default("")
  lastName         String              @default("")
  email            String              @unique
  password         String
  role             Role                @default(CUSTOMER)
  bio              String?
  // Practitioner profile photo URL — admin pastes a hosted image link.
  // Nullable — falls back to initials monogram in the public "Who teaches"
  // band when absent.
  image            String?
  commissionRate   Float               @default(70)
  isActive         Boolean             @default(true)
  resetToken       String?             @unique
  resetTokenExpiry DateTime?
  // Copied into each session token at sign-in. Bumping it (password reset or
  // change) signs the user out everywhere: older tokens no longer match.
  sessionVersion   Int                 @default(0)
  // When the owner proved they control the address: a verification link, a
  // password-reset link or Google sign-in. Null means never proved, so Google
  // sign-in with this email takes the account over (see lib/google-account).
  emailVerified    DateTime?
  // Indexed, not @unique: adding a unique constraint makes `prisma db push`
  // (run by deploy.sh) stop with a data-loss warning. Tokens are 256-bit
  // random, so collisions aren't a concern.
  verifyToken      String?
  verifyExpiry     DateTime?
  createdAt        DateTime            @default(now())
  courses          Course[]            @relation("InstructorCourses")
  enrollments      Enrollment[]
  earnings         InstructorEarning[]
  assignedLeads    Lead[]              @relation("AssignedLeads")
  leadNotes        LeadNote[]          @relation("LeadNotes")
  orders           Order[]

  @@index([verifyToken])
}

model Course {
  id                String              @id @default(cuid())
  title             String
  slug              String              @unique
  shortDescription  String
  fullDescription   String
  deliveryType      DeliveryType
  // Course format — how this course is delivered in TIME:
  //   COHORT     → live cohort with fixed start/end dates
  //   SELF_PACED → recorded / on-demand / always available
  //   WORKSHOP   → one-time live event (no end date, single session)
  // Existing rows default to COHORT so the migration is safe.
  courseFormat      CourseFormat        @default(COHORT)
  // For COHORT / WORKSHOP courses: is the schedule confirmed?
  //   SCHEDULED → admin has set concrete dates
  //   TBC       → cohort planned, dates announced soon
  //   COMPLETED → past cohort, no current schedule
  // Ignored when courseFormat = SELF_PACED.
  scheduleStatus    ScheduleStatus      @default(SCHEDULED)
  category          String
  level             String
  price             Float
  discountPrice     Float?
  durationHours     Int
  startDate         DateTime?
  endDate           DateTime?
  seatCapacity      Int?
  location          String?
  instructorId      String?
  thumbnail         String?
  marketingVideoUrl String?
  status            CourseStatus        @default(DRAFT)
  approvalStatus    ApprovalStatus      @default(APPROVED)
  rejectionReason   String?
  // Featured slot on the home-page NeuralPathway scene. Values 1, 2,
  // or 3 → mapped to the three featurable course positions in
  // `NeuralPathway.tsx`. Slot 4 is reserved for the centered
  // "Browse all courses" CTA card and is not admin-controllable.
  // @@unique enforces one course per slot at the DB level; the API
  // route transactionally clears the slot from any prior holder so
  // newest assignment wins.
  featuredSlot      Int?                @unique
  // Optional "What you'll learn" overrides rendered ON THE HOME PAGE
  // when this course is featured (via featuredSlot). When null/empty
  // the slot's hardcoded defaults in NeuralPathway.tsx are used.
  // These don't render anywhere else — they're home-page specific.
  highlightStatValue  String?           // e.g. "8 wks", "Live", "10 hrs"
  highlightStatLabel  String?           // e.g. "Cohort length", "Format"
  highlightBullets    String[]          // up to ~4 short lines
  createdAt         DateTime            @default(now())
  instructor        User?               @relation("InstructorCourses", fields: [instructorId], references: [id])
  enrollments       Enrollment[]
  earnings          InstructorEarning[]
  lessons           Lesson[]
  orders            Order[]

  @@index([instructorId])
}

model Lesson {
  id          String     @id @default(cuid())
  courseId    String
  moduleTitle String
  lessonTitle String
  lessonType  LessonType @default(CONTENT)
  videoUrl    String?
  content     String?
  resources   String?
  questions   Json?
  orderIndex  Int
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@index([courseId])
}

model Service {
  id           String   @id @default(cuid())
  title        String
  description  String
  category     String
  pricingModel String?
  featured     Boolean  @default(false)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  courseId        String
  amount          Float
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String        @default("BANK_TRANSFER")
  stripeSessionId String?
  createdAt       DateTime      @default(now())
  course          Course        @relation(fields: [courseId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([courseId])
}

model Enrollment {
  id                 String   @id @default(cuid())
  userId             String
  courseId           String
  progressPercentage Float    @default(0)
  completed          Boolean  @default(false)
  createdAt          DateTime @default(now())
  course             Course   @relation(fields: [courseId], references: [id])
  user               User     @relation(fields: [userId], references: [id])
  lessonProgress     LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// One row per lesson a learner has completed. Enrollment.progressPercentage
// is derived from these rows on the server; it used to be the only record,
// so a reload could not tell which lessons were done.
model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

model InstructorEarning {
  id            String   @id @default(cuid())
  instructorId  String
  courseId      String
  amount        Float
  platformCut   Float
  instructorCut Float
  period        String
  createdAt     DateTime @default(now())
  course        Course   @relation(fields: [courseId], references: [id])
  instructor    User     @relation(fields: [instructorId], references: [id])

  @@index([instructorId])
  @@index([courseId])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  content   String
  rating    Int      @default(5)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BrandSettings {
  id           String  @id @default(cuid())
  logo         String?
  primaryColor String  @default("#0F1E3D")
  accentColor  String  @default("#18A999")
  companyName  String  @default("FutureLine")
  tagline      String  @default("Design • Deploy • Evolve")
  contactEmail String  @default("flservices.ai@gmail.com")
  tourismEmail String  @default("authentic.tour.om@gmail.com")
  // Bank-transfer checkout: who customers pay (as they should see it) and the
  // WhatsApp number they send the receipt to. Admin > Brand edits both.
  bankPayee       String @default("Musab Al Sabahi, 96532326")
  receiptWhatsapp String @default("96532326")
}

model AISettings {
  id             String  @id @default(cuid())
  enabled        Boolean @default(true)
  welcomeMessage String  @default("Let our AI help you find the perfect course")
}

model Lead {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  company         String?
  tourType        String
  message         String
  source          String         @default("FL Tourism")
  stage           LeadStage      @default(NEW)
  priority        LeadPriority   @default(MEDIUM)
  assignedTo      String?
  tags            String?
  value           Float?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  assignee        User?          @relation("AssignedLeads", fields: [assignedTo], references: [id])
  activities      LeadActivity[]
  notes           LeadNote[]
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  type        String
  description String
  metadata    Json?
  performedBy String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  content   String
  authorId  String?
  createdAt DateTime @default(now())
  author    User?    @relation("LeadNotes", fields: [authorId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  type      String
  subject   String
  body      String
  variables String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationRule {
  id            String   @id @default(cuid())
  name          String
  description   String?
  triggerType   String
  triggerConfig Json
  actionType    String
  actionConfig  Json
  delayHours    Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  resetTime DateTime
}

enum Role {
  ADMIN
  INSTRUCTOR
  CUSTOMER
}

enum DeliveryType {
  ONLINE
  IN_PERSON
  HYBRID
}

// How a course is delivered in TIME — orthogonal to DeliveryType
// (which is about WHERE — online / in-person / hybrid).
enum CourseFormat {
  COHORT       // Live cohort with fixed start/end dates
  SELF_PACED   // Recorded / on-demand / always available
  WORKSHOP     // One-time live event (single session)
}

// For cohort & workshop courses: is the schedule confirmed yet?
// Self-paced courses ignore this — they're always available.
enum ScheduleStatus {
  SCHEDULED  // Admin set concrete dates
  TBC        // Cohort planned, dates announced soon
  COMPLETED  // Past cohort, no current schedule
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum LessonType {
  CONTENT
  QUIZ
}

enum LeadStage {
  NEW
  CONTACTED
  OFFER_SENT
  FOLLOW_UP
  NEGOTIATING
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
