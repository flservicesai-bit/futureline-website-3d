# ─────────────────────────────────────────────────────────────
# FutureLine — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Postgres connection string. Required for the database (users, leads,
# courses, rate limiting). Without it, DB-backed features error.
DATABASE_URL="postgresql://user:password@localhost:5432/futureline"

# NextAuth. Secret signs the session JWT (use any long random string,
# e.g. `openssl rand -base64 32`). URL is the site's own origin.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:5123"

# Google sign-in (the "Continue with Google" button on /get-started/signin).
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:  <NEXTAUTH_URL>/api/auth/callback/google
#   local: http://localhost:5123/api/auth/callback/google
#   prod:  https://futureline.ai/api/auth/callback/google
# The button renders regardless, but Google login only works once both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Proxies in front of the app that append to X-Forwarded-For. Rate limits
# trust only entries those proxies added. 1 = nginx only (the default).
# Set to 2 if Cloudflare (or another proxy) sits in front of nginx.
TRUSTED_PROXY_COUNT="1"

# Transactional email (Resend). Without an API key nothing is sent.
# RESEND_FROM_EMAIL must be an address on a domain verified in Resend: the
# fallback, onboarding@resend.dev, only delivers to the Resend account owner.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="FutureLine <noreply@futureline.ai>"
# Where customer replies and team alerts go.
REPLY_TO_EMAIL="flservices.ai@gmail.com"
ADMIN_EMAIL="flservices.ai@gmail.com"

# Local testing only: with no RESEND_API_KEY, a production build (`next start`)
# sends nothing and logs only "NOT SENT". Set this to print full email bodies
# instead (they contain reset and verification links). Never set it on the server.
# EMAIL_LOG_BODIES="true"
